              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok es true\", () => pm.expect(pm.response.json().ok).to.be.true);",
                  "const r = pm.response.json().resultado;",
                  "pm.test(\"Hay 3 recintos del seed\", () => pm.expect(r.length).to.be.at.least(3));",
                  "const wizink = r.find(x => x.nombre === \"WiZink Center\") || r[0];",
                  "pm.collectionVariables.set(\"recintoId\", wizink._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
